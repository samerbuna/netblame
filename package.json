{
  "name": "netblame",
  "version": "0.1.0",
  "description": "Tells you whose fault a bad internet connection is: your Wi-Fi, your router, your internet provider, DNS, or your own computer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samerbuna/netblame.git"
  },
  "homepage": "https://github.com/samerbuna/netblame#readme",
  "bugs": "https://github.com/samerbuna/netblame/issues",
  "keywords": [
    "network",
    "monitor",
    "internet",
    "outage",
    "wifi",
    "uptime",
    "latency",
    "bufferbloat",
    "cli"
  ],
  "type": "module",
  "bin": {
    "netblame": "dist/cli.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "start": "node src/cli.ts",
    "dev": "node --watch src/cli.ts run",
    "build": "node --disable-warning=ExperimentalWarning scripts/build.ts",
    "check": "tsc",
    "test": "node --test test/*.test.ts",
    "prepack": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
